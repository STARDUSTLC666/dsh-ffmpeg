{
  "name": "dsh-ffmpeg",
  "version": "0.7.18",
  "description": "DeepSeek Harness 音视频处理插件：本机 FFmpeg 探测、剪辑转码、字幕烧录、抽帧与 GIF 导出。欢迎提交 issues 和 PR。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/update-client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/plugin-icon.webp"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md",
    "assets/plugin-icon.webp",
    "locale"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-updates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ffmpeg",
    "video",
    "media",
    "dsh-plugin",
    "deepseek",
    "ai-agent",
    "audio",
    "gif",
    "音视频"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-ffmpeg.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-ffmpeg/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-ffmpeg#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@stardustlc/dsh-updates": "0.2.7"
  },
  "icon": "./assets/plugin-icon.webp"
}
